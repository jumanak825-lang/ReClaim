# Reclaim API environment template. NEVER commit real values.
# The API reads these from the process environment (export them, or use uvicorn --env-file).
# Defaults shown here match local development with `docker compose up -d db`.

# --- URLs ---
APP_BASE_URL=http://localhost:3000          # web origin; PayPal (mock) redirects back here
API_BASE_URL=http://localhost:8000          # API origin
CORS_ORIGINS=http://localhost:3000          # comma-separated allowed origins

# --- Database ---
DATABASE_URL=postgresql+psycopg://reclaim:reclaim@localhost:5433/reclaim   # Compose publishes 5433
# TEST_DATABASE_URL=postgresql+psycopg://reclaim:reclaim@localhost:5433/reclaim_test  # tests only

# --- Sessions (server-side, Postgres; no JWT) ---
SESSION_TTL_HOURS=12                        # session cookie lifetime
COOKIE_SECURE=false                         # true behind HTTPS

# --- Rate limits ("<count>/<seconds>") ---
RATE_LIMITS_ENABLED=true
RATE_LIMIT_AUTH=10/60                       # login/register, per IP and per email
RATE_LIMIT_UPLOAD=30/60                     # per user
RATE_LIMIT_CLAIM=5/300                      # claim submissions per user

# --- Background worker ---
WORKER_MODE=embedded                        # embedded (API runs it) | external (run `python -m app.workers`)
WORKER_POLL_SECONDS=1
WORKER_MAX_ATTEMPTS=6                       # then the outbox event is marked dead

# --- Uploads ---
UPLOAD_PROVIDER=local                       # only `local` is implemented
UPLOAD_DIR=                                 # default: apps/api/var/uploads

# --- AI extraction (deterministic fallback when unset) ---
AI_PROVIDER=xai
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_VISION_MODEL=                            # confirm the current vision model id on docs.x.ai
AI_TIMEOUT_SECONDS=30

# --- PayPal (Sandbox) ---
PAYPAL_MODE=auto                            # auto: sandbox when client id+secret are set, else mock | sandbox | mock
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Check credentials without printing them: python scripts/check_paypal.py
PAYPAL_WEBHOOK_ID=                          # webhooks are rejected (503) until all three are set

# --- Zapier (one catch hook for the hackathon) ---
ZAPIER_WEBHOOK_URL=                         # events are skipped until URL and secret are both set
ZAPIER_WEBHOOK_SECRET=                      # HMAC key for X-Reclaim-Signature

# --- Demo / local development ---
SIMULATED_COURIER_SECONDS=20                # dispatched -> in_transit delay (simulated courier)
ENABLE_DEV_ROUTES=false                     # true enables /api/v1/dev/* (reset, mock PayPal). Local only; never with ngrok
