# Reclaim environment template. Copy to .env and fill in. NEVER commit .env.
# Variables marked (stub) are read by the current stub API; the rest are for the real backend.

# --- URLs ---
APP_BASE_URL=http://localhost:3000          # (stub) web origin; mock PayPal redirects back here
API_BASE_URL=http://localhost:8000          # (stub) API origin; used to build the mock approval_url
CORS_ORIGINS=http://localhost:3000          # (stub) comma-separated allowed origins

# --- Sessions ---
SESSION_TTL_HOURS=12                        # (stub) session cookie lifetime
COOKIE_SECURE=false                         # (stub) true behind HTTPS

# --- Stub-only behaviour ---
STUB_PROCESSING_SECONDS=2                   # (stub) fake processing delay for reports/extraction
STUB_COURIER_SECONDS=20                     # (stub) dispatched -> in_transit delay (simulated courier)

# --- Database (real backend) ---
DATABASE_URL=postgresql+psycopg://reclaim:reclaim@localhost:5432/reclaim

# --- Uploads (real backend) ---
UPLOAD_PROVIDER=local                       # local | s3 | cloudinary | supabase
UPLOAD_BUCKET=

# --- AI (real backend; deterministic fallback when unset) ---
AI_PROVIDER=xai
AI_API_KEY=
AI_VISION_MODEL=
AI_TEXT_MODEL=

# --- PayPal (Sandbox by default) ---
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Zapier ---
ZAPIER_WEBHOOK_URL=                         # (stub) shown as configured/not_configured only; stub never sends
ZAPIER_WEBHOOK_SECRET=
